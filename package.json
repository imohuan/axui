{
  "name": "axui",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/axui.umd.js",
  "module": "./dist/axui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/axui.es.js",
      "require": "./dist/axui.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/style.css",
    "./*": "./*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --config vite.config.lib.ts && vue-tsc -p tsconfig.lib.json && node scripts/copy-types.js",
    "build:types": "vue-tsc -p tsconfig.lib.json",
    "build:cdn": "node scripts/build-cdn.js",
    "dev:cdn": "concurrently -n build,serve -c cyan,green \"vite build --config vite.config.cdn.ts --watch\" \"live-server dist-cdn --port=3000 --no-browser\"",
    "preview": "vite preview",
    "prepush": "node scripts/install.js",
    "prepare": "husky",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@floating-ui/vue": "^1.1.11",
    "@fontsource/geist": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@vueuse/core": "^14.3.0",
    "esbuild": "^0.28.0",
    "material-symbols": "^0.44.10",
    "vue-sonner": "^2.0.9"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "live-server": "^1.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
